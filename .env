###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_this_secret_in_production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL for the PostgreSQL database used by this project.
# Matches the docker-compose.yml service defined at the project root:
#   user=cinema  password=cinema  host=127.0.0.1  port=5432  db=cinema_crud
DATABASE_URL="postgresql://cinema:cinema@127.0.0.1:5432/cinema_crud?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# dev: log emails to var/log instead of really sending them
MAILER_DSN=null://null
###< symfony/mailer ###
