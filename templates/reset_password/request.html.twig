{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublie{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <h1 class="h3 mb-3 text-center">Mot de passe oublie</h1>
            <p class="text-muted">Saisissez votre adresse email, un lien de reinitialisation vous sera envoye.</p>

            {{ form_start(requestForm) }}
                {{ form_row(requestForm.email) }}
                <button class="btn btn-primary w-100 mt-2" type="submit">Envoyer le lien</button>
            {{ form_end(requestForm) }}

            <p class="text-center mt-3">
                <a href="{{ path('app_login') }}">Retour a la connexion</a>
            </p>
        </div>
    </div>
{% endblock %}
