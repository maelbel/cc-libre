{% extends 'admin/base.html.twig' %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Films</h1>
        <a href="{{ path('admin_film_new') }}" class="btn btn-primary">+ Nouveau film</a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-12 col-md-8">
            <input type="search" name="search" value="{{ search }}" class="form-control" placeholder="Rechercher par titre ou genre">
        </div>
        <div class="col-12 col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-secondary">Rechercher</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>Titre</th>
                <th>Annee</th>
                <th>Genre</th>
                <th>Seances</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for film in pagination %}
                <tr>
                    <td>{{ film.titre }}</td>
                    <td>{{ film.annee }}</td>
                    <td>{{ film.genre }}</td>
                    <td>{{ film.seances|length }}</td>
                    <td class="text-end">
                        <a href="{{ path('admin_film_edit', {id: film.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        <form action="{{ path('admin_film_delete', {id: film.id}) }}" method="post" class="d-inline"
                              onsubmit="return confirm('Supprimer ce film et ses seances ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_film_' ~ film.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted">Aucun film.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(pagination) }}
    </div>
{% endblock %}
