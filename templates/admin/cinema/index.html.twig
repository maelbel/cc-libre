{% extends 'admin/base.html.twig' %}

{% block admin_body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Cinemas</h1>
        <a href="{{ path('admin_cinema_new') }}" class="btn btn-primary">+ Nouveau cinema</a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-12 col-md-8">
            <input type="search" name="search" value="{{ search }}" class="form-control" placeholder="Rechercher par nom ou ville">
        </div>
        <div class="col-12 col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-secondary">Rechercher</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>Nom</th>
                <th>Ville</th>
                <th>Adresse</th>
                <th>Salles</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for cinema in pagination %}
                <tr>
                    <td>{{ cinema.nom }}</td>
                    <td>{{ cinema.ville }}</td>
                    <td>{{ cinema.adresseComplete }}</td>
                    <td>{{ cinema.salles|length }}</td>
                    <td class="text-end">
                        <a href="{{ path('admin_cinema_edit', {id: cinema.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        <form action="{{ path('admin_cinema_delete', {id: cinema.id}) }}" method="post" class="d-inline"
                              onsubmit="return confirm('Supprimer ce cinema et toutes ses salles/seances ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_cinema_' ~ cinema.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted">Aucun cinema.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(pagination) }}
    </div>
{% endblock %}
