{% extends 'admin/base.html.twig' %}

{% block admin_body %}
    <h1 class="h3 mb-3">{{ isNew ? 'Nouveau cinema' : 'Modifier le cinema' }}</h1>

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.ville) }}
        {{ form_row(form.rue) }}
        {{ form_row(form.numero) }}
        <div class="mt-3">
            {{ form_widget(form.submit) }}
            <a href="{{ path('admin_cinema_index') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
